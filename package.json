{
  "name": "browser-brawl",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "concurrently -n server,client -c magenta,cyan \"pnpm --filter @game/server dev\" \"pnpm --filter @game/client dev\"",
    "dev:client": "pnpm --filter @game/client dev",
    "dev:server": "pnpm --filter @game/server dev",
    "test": "pnpm --filter @game/simulation test && pnpm --filter @game/physics test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm typecheck && pnpm lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}

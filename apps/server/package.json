{
  "name": "@game/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp node --watch --import tsx src/main.ts",
    "start": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp node --import tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@colyseus/ws-transport": "^0.16.5",
    "@game/config": "workspace:*",
    "@game/physics": "workspace:*",
    "@game/protocol": "workspace:*",
    "@game/simulation": "workspace:*",
    "colyseus": "^0.16.5",
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.13",
    "tsx": "^4.20.3"
  }
}
